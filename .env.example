# Firebase Web App config (required for web app)
# Get these from Firebase Console → Project settings → Your apps → Web app (or "Add app")
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NASCAR data: leave commented. We use built-in 2026 data and/or scrape from NASCAR.com/ESPN (no external API).
# NASCAR_PROVIDER_BASE_URL=
# NASCAR_PROVIDER_TOKEN=
