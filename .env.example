# Firebase Web App config (required for web app)
# Get these from Firebase Console → Project settings → Your apps → Web app (or "Add app")
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# NASCAR data is pulled directly by Cloud Functions from NASCAR CF feeds.

# Optional Cloud Functions reminder controls (set in your deploy/runtime environment):
# ENABLE_PUSH_REMINDERS=1
# ENABLE_EMAIL_REMINDERS=0
# REMINDER_EMAIL_FROM=
