{
  "name": "nascar-pickem-functions",
  "private": true,
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": { "node": "20" },
  "scripts": {
    "build": "npx esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=lib/index.bundle.js --external:firebase-admin --external:firebase-functions --sourcemap && cp src/loader.cjs lib/index.js",
    "build:tsc": "tsc",
    "lint": "tsc --noEmit",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "test": "npm run lint"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3"
  }
}
