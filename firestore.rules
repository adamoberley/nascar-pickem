rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath(leagueId) {
      return /databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid);
    }

    function isMember(leagueId) {
      return isSignedIn() && 
        exists(memberPath(leagueId)) &&
        get(memberPath(leagueId)).data != null;
    }

    function isAdmin(leagueId) {
      return isMember(leagueId) && get(memberPath(leagueId)).data.role == "admin";
    }

    function racePath(leagueId, raceId) {
      return /databases/$(database)/documents/leagues/$(leagueId)/races/$(raceId);
    }

    function raceStarted(leagueId, raceId) {
      return exists(racePath(leagueId, raceId)) &&
        (request.time >= get(racePath(leagueId, raceId)).data.startTime ||
         get(racePath(leagueId, raceId)).data.status == "completed");
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read, update: if isSignedIn() && request.auth.uid == userId;
        allow create, delete: if false;
      }

      match /devices/{deviceId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Collection group query rule for members - allows users to read their own member documents
    // Supports querying by userId field (for collection group queries) or document ID (for direct access)
    // For collection group queries: checks if userId field matches authenticated user
    // For direct access: checks if document ID matches authenticated user
    match /{path=**}/members/{memberDocId} {
      allow read: if isSignedIn() && 
        (request.auth.uid == memberDocId || 
         (resource != null && resource.data.get("userId", "") == request.auth.uid));
    }

    match /leagues/{leagueId} {
      allow read: if isMember(leagueId);
      allow create: if false;
      allow update, delete: if false;

      match /members/{userId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /races/{raceId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /drivers/{driverId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /standingsSnapshots/{snapshotId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /tiers/{raceId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /picks/{pickId} {
        allow read: if isMember(leagueId) &&
          (isAdmin(leagueId) ||
           resource.data.userId == request.auth.uid ||
           (resource.data.raceId is string && raceStarted(leagueId, resource.data.raceId)));

        allow create, update, delete: if false;
      }

      match /racePoints/{raceId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /adjustments/{adjustmentId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /weeklyScores/{scoreId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }

      match /seasonScores/{userId} {
        allow read: if isMember(leagueId);
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
